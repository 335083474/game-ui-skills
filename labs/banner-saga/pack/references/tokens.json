{
  "meta": {
    "style": "Nordic hand-painted travel and war UI",
    "version": "0.1",
    "fontFilesBundled": false,
    "artDirectionOnly": true
  },
  "color": {
    "ink": "#252b2d",
    "paper": "#e8dfc7",
    "accent": "#ad4c35",
    "secondary": "#647d7a",
    "dark": "#172326",
    "light": "#f4edda"
  },
  "type": {
    "display": "Georgia, 'Palatino Linotype', serif",
    "body": "'Trebuchet MS', Arial, sans-serif",
    "bodySize": "0.95rem",
    "labelSize": "0.78rem",
    "titleSize": "clamp(1.4rem, 3vw, 2.4rem)",
    "lineHeight": 1.5
  },
  "shape": {
    "corner": "0.25rem",
    "frame": "1px solid rgba(37,43,45,.26)",
    "hitTarget": "2.75rem",
    "ornament": "thin hand-drawn edge marks; never a hit area"
  },
  "space": {
    "unit": 4,
    "controlGap": 12,
    "sectionGap": 24,
    "readingMax": "68ch"
  },
  "motion": {
    "selectionMs": 140,
    "revealMs": 220,
    "reducedMotion": "disable nonessential movement"
  },
  "accessibility": {
    "minContrastTarget": "4.5:1 for body text",
    "focus": "2px visible outline with offset",
    "selection": "shape and label in addition to color"
  }
}

