{
  "meta": {
    "style": "1930s rubber-hose cartoon game UI",
    "version": "0.1",
    "fontFilesBundled": false,
    "originalArtOnly": true
  },
  "color": {
    "ink": "#171719",
    "paper": "#fff0d0",
    "accent": "#d9463f",
    "secondary": "#3f8b66",
    "dark": "#1b1c20",
    "light": "#fff6df"
  },
  "type": {
    "display": "Georgia, 'Palatino Linotype', serif",
    "body": "Arial, sans-serif",
    "bodySize": "1rem",
    "labelSize": ".75rem",
    "titleSize": "clamp(1.5rem,4vw,2.7rem)",
    "lineHeight": 1.45
  },
  "shape": {
    "radius": "0.2rem",
    "outline": "2px solid currentColor",
    "minTarget": "44px",
    "frame": "ink line with irregular/print edge detail"
  },
  "space": {
    "unit": 4,
    "controlGap": 12,
    "sectionGap": 24,
    "copyMax": "62ch"
  },
  "motion": {
    "selectionMs": 130,
    "revealMs": 240,
    "reduceMotion": "disable nonessential animation"
  },
  "accessibility": {
    "bodyContrastTarget": "4.5:1",
    "focus": "visible 2px outline",
    "stateEncoding": "text plus shape plus color"
  }
}

