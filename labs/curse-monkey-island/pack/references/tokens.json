{
  "meta": {
    "style": "Hand-painted pirate-cartoon adventure UI",
    "version": "0.1",
    "fontFilesBundled": false,
    "originalArtOnly": true
  },
  "color": {
    "ink": "#342824",
    "paper": "#f5e4bc",
    "accent": "#bd4934",
    "secondary": "#31766e",
    "dark": "#273d4a",
    "light": "#fff3d5"
  },
  "type": {
    "display": "Georgia, serif",
    "body": "'Trebuchet MS', Arial, sans-serif",
    "bodySize": "1rem",
    "labelSize": ".75rem",
    "titleSize": "clamp(1.5rem,4vw,2.7rem)",
    "lineHeight": 1.45
  },
  "shape": {
    "radius": "0.2rem",
    "outline": "2px solid currentColor",
    "minTarget": "44px",
    "frame": "ink line with irregular/print edge detail"
  },
  "space": {
    "unit": 4,
    "controlGap": 12,
    "sectionGap": 24,
    "copyMax": "62ch"
  },
  "motion": {
    "selectionMs": 130,
    "revealMs": 240,
    "reduceMotion": "disable nonessential animation"
  },
  "accessibility": {
    "bodyContrastTarget": "4.5:1",
    "focus": "visible 2px outline",
    "stateEncoding": "text plus shape plus color"
  }
}

