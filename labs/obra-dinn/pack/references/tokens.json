{
  "meta": {
    "style": "1-bit nautical ledger",
    "version": "0.1",
    "bundledFonts": false
  },
  "color": {
    "ink": "#e8e3d2",
    "paper": "#0d1110",
    "accent": "#f0ead6",
    "secondary": "#8d9386",
    "dark": "#070a09",
    "light": "#d8d3c4"
  },
  "type": {
    "display": "'Courier New', monospace",
    "body": "'Courier New', monospace",
    "bodySize": "1rem",
    "labelSize": ".75rem",
    "lineHeight": 1.45
  },
  "shape": {
    "corner": "0px",
    "rules": "1px solid currentColor",
    "focus": "inverted block plus outline",
    "target": "44px"
  },
  "space": {
    "unit": 4,
    "rowGap": 8,
    "sectionGap": 20
  },
  "motion": {
    "selectionMs": 100,
    "reducedMotion": "disable blink and scan animation"
  },
  "accessibility": {
    "state": "text and symbol, not color alone",
    "contrast": "high contrast for all critical copy"
  }
}

