{
  "meta": {
    "style": "Atmospheric hand-painted forest",
    "edition": "Will of the Wisps (2020) direction only",
    "version": "0.1",
    "fontsBundled": false
  },
  "color": {
    "ink": "#e8f0e9",
    "paper": "#101b20",
    "accent": "#8bded9",
    "secondary": "#efbf76",
    "dark": "#0c151b",
    "light": "#e2eee5",
    "forest": "#1c3437",
    "glint": "rgba(139,222,217,.22)"
  },
  "type": {
    "display": "Georgia, serif",
    "body": "Trebuchet MS, Arial, sans-serif",
    "bodySize": "1rem",
    "labelSize": ".76rem",
    "lineHeight": 1.5
  },
  "shape": {
    "corner": "small and quiet",
    "rule": "1px organic low-contrast line",
    "target": "44px",
    "focus": "thin double ring plus label"
  },
  "space": {
    "unit": 4,
    "controlGap": 12,
    "sectionGap": 24,
    "readingMax": "64ch"
  },
  "motion": {
    "highlightMs": 180,
    "environmentMs": 500,
    "reducedMotion": "disable shimmer and ambient drift"
  },
  "accessibility": {
    "contrast": "4.5:1 target for body text",
    "state": "shape and label with restrained hue",
    "glow": "decorative only"
  }
}

