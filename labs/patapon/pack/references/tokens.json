{
  "meta": {
    "style": "Tribal silhouette and rhythm command",
    "version": "0.1",
    "fontFilesBundled": false
  },
  "color": {
    "ink": "#111118",
    "paper": "#f4f0dc",
    "accent": "#f47758",
    "secondary": "#25a9a1",
    "dark": "#251b34",
    "light": "#fff4db"
  },
  "type": {
    "display": "Trebuchet MS, Arial, sans-serif",
    "body": "Arial, sans-serif",
    "bodySize": "1rem",
    "labelSize": ".72rem",
    "lineHeight": 1.45
  },
  "shape": {
    "corner": "0px or bold circle",
    "line": "3px solid ink",
    "target": "48px",
    "glyph": "high-contrast circle/diamond/bar"
  },
  "space": {
    "unit": 4,
    "beatGap": 10,
    "sectionGap": 24
  },
  "motion": {
    "beatPulseMs": 160,
    "reducedMotion": "replace movement with stable fill and text status"
  },
  "accessibility": {
    "beatText": "announce state changes, not every animation frame",
    "stateEncoding": "shape, text, color"
  }
}

