    "items": {
      "coins": {"column": 0, "row": 0, "x": 0, "y": 0, "backgroundPosition": "0% 0%"},
      "potion": {"column": 1, "row": 0, "x": 512, "y": 0, "backgroundPosition": "50% 0%"},
      "crystal": {"column": 2, "row": 0, "x": 1024, "y": 0, "backgroundPosition": "100% 0%"},
      "strawberry": {"column": 0, "row": 1, "x": 0, "y": 512, "backgroundPosition": "0% 100%"},
      "watering-can": {"column": 1, "row": 1, "x": 512, "y": 512, "backgroundPosition": "50% 100%"},
      "seeds": {"column": 2, "row": 1, "x": 1024, "y": 512, "backgroundPosition": "100% 100%"}
    }
