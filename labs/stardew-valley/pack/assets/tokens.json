  "spacing": {"unit": 4, "steps": [4, 8, 12, 16, 24, 32, 40, 48], "desktopSafe": 32, "mobileSafe": 16},
  "geometry": {"panelWoodBorder": 12, "cardWoodBorder": 6, "slotWoodBorder": 4, "cornerRadius": 0, "buttonHeight": 48, "buttonDepth": 5, "panelDepth": 8, "pixelUnit": 4},
  "typography": {"family": "Pixelify Sans", "fallback": "Microsoft YaHei, PingFang SC, Noto Sans CJK SC, sans-serif", "metadata": 14, "body": 18, "label": 20, "cardTitle": 24, "value": 30, "heading": 44, "lineHeight": 1.35},
  "effects": {"blur": false, "crt": false, "scanlines": false, "requiredAnimation": false, "shadow": "hard-edged brown, no ambient blur"},
  "atlas": {
