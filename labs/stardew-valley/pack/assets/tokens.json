{
  "name": "Stardew Valley inspired pastoral pixel UI",
  "version": "1.0.0",
  "colors": {
    "sky": "#80bbca", "skyLight": "#beded4", "grass": "#739549", "grassLight": "#9fbb61", "grassDark": "#406e3d",
    "woodDark": "#542b18", "woodShadow": "#713c1f", "wood": "#a95f2a", "woodLight": "#d38c3e", "woodHighlight": "#f0b75c",
    "paper": "#f9dba0", "paperLight": "#ffe9b8", "paperShade": "#edc784", "ink": "#4b2818", "mutedInk": "#825b34",
    "amber": "#f6b534", "amberLight": "#ffdc70", "amberDepth": "#b7681d", "leaf": "#4f7538", "leafLight": "#77984b", "leafDepth": "#33542c",
    "danger": "#9f4434", "disabled": "#cfbb91", "focus": "#244f3b"
